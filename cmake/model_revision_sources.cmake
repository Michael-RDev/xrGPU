# Model Session eligibility fingerprints exclude the standalone native catalog.
# The catalog has its own checksummed source/build inventory and qualification.
function(xrgpu_model_kernel_sources root output)
  if(CMAKE_SCRIPT_MODE_FILE)
    set(_watch)
  else()
    set(_watch CONFIGURE_DEPENDS)
  endif()
  file(GLOB _contracts ${_watch} "${root}/kernels/*/contract.json")
  set(_sources)
  foreach(_contract IN LISTS _contracts)
    get_filename_component(_folder "${_contract}" DIRECTORY)
    if(IS_SYMLINK "${_contract}" OR IS_SYMLINK "${_folder}")
      message(FATAL_ERROR "Kernel contract links are not allowed: ${_contract}")
    endif()
    file(READ "${_contract}" _json)
    string(JSON _kind ERROR_VARIABLE _error GET "${_json}" kind)
    if(_error OR NOT _kind STREQUAL "xrgpu.model-override")
      continue()
    endif()
    file(GLOB_RECURSE _files ${_watch}
      "${_folder}/*.glsl" "${_folder}/*.yaml" "${_folder}/*.json" "${_folder}/*.h")
    list(APPEND _sources ${_files})
  endforeach()
  list(REMOVE_DUPLICATES _sources)
  list(SORT _sources)
  set(${output} "${_sources}" PARENT_SCOPE)
endfunction()
