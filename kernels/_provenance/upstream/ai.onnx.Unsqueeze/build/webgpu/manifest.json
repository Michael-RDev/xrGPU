{
  "domain": "ai.onnx",
  "name": "Unsqueeze",
  "sinceVersion": 13,
  "inputs": {
    "data": { "dtype": "T" },
    "axes": { "dtype": "S", "rank": 1, "storage": "int32", "narrowing": "checked" }
  },
  "outputs": { "expanded": { "dtype": "T", "rank": "ranks.data + dim(shapes.axes, 0)" } },
  "typeConstraints": {
    "T": ["float32", "float16", "int32", "uint32", "int16", "uint8", "int8", "bool", "int64"],
    "S": ["int64"]
  },
  "tunables": { "WORKGROUP_SIZE": { "default": 256 } },
  "derive": { "axesContract": "present.axes and ranks.axes == 1" },
  "when": ["axesContract", "numel(shapes.data) == numel(shapes.expanded)", "f16Ok(dtypes.T)"],
  "bindings": {
    "src": { "arg": "data", "elementType": "$vectorScalar" },
    "dst": { "arg": "expanded", "elementType": "$vectorScalar" },
    "x": { "arg": "data", "elementType": "$scalar" },
    "y": { "arg": "expanded", "elementType": "$scalar" }
  },
  "variants": [
    {
      "id": "copy_vec4",
      "priority": 20,
      "when": ["dtypes.T != \"vec2<u32>\"", "numel(shapes.data) > 0", "numel(shapes.data) % 4 == 0"],
      "derive": { "vectorScalar": "\"vec4<\" ~ dtypes.T ~ \">\"" },
      "passes": [
        {
          "id": "main",
          "name": "Unsqueeze.CopyVec4",
          "shader": "datamove-flat-copy.wgsl.jinja",
          "derive": { "count": "numel(shapes.expanded) / 4" },
          "bindings": ["src", "dst"],
          "dispatch": {
            "x": "min(ceilDiv((numel(shapes.expanded) / 4), (tunables.WORKGROUP_SIZE)), min(device.limits.maxComputeWorkgroupsPerDimension, 65535))",
            "y": 1,
            "z": 1
          },
          "viewAlias": [{ "input": "src", "output": "dst" }]
        }
      ]
    },
    {
      "id": "copy",
      "derive": { "scalar": "dtypes.T" },
      "passes": [
        {
          "id": "main",
          "name": "Unsqueeze",
          "shader": "datamove-elementwise-copy.wgsl.jinja",
          "bindings": [
            "x",
            "y",
            { "name": "params", "struct": [{ "name": "count", "type": "u32", "value": "numel(shapes.expanded)" }] }
          ],
          "dispatch": {
            "x": "min(ceilDiv((numel(shapes.expanded)), (tunables.WORKGROUP_SIZE)), min(device.limits.maxComputeWorkgroupsPerDimension, 65535))",
            "y": 1,
            "z": 1
          },
          "viewAlias": [{ "input": "x", "output": "y" }]
        }
      ]
    }
  ]
}
