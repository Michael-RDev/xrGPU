  "typeConstraints": { "T": ["float32", "float16"] },
  "tunables": { "workgroupSize": { "default": 256 }, "tiledWorkgroupSize": { "default": 128 } },
  "derive": {
    "channels": "dim(shapes.inputT, 2 if attrs.channels_last == 1 else 1)",
