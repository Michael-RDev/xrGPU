      "vars": { "dtype": "float16", "count": 8388608 },
      "inputs": { "input": { "shape": [8388608], "dtype": "float16", "seed": 7026, "dist": "normal", "scale": 2 } },
      "outputs": { "output": { "shape": [8388608], "dtype": "float16" } },
