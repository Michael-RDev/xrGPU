            { "scratch": "aF32", "name": "y", "elementType": "f32" },
            { "name": "params", "struct": [{ "name": "count", "type": "u32", "value": "numel(shapes.aT)" }] }
          ],
          "dispatch": {
            "x": "min(ceilDiv((ceilDiv(numel(shapes.aT), 4)), (tunables.WORKGROUP_SIZE)), 65535)",
            "y": "ceilDiv(ceilDiv((ceilDiv(numel(shapes.aT), 4)), (tunables.WORKGROUP_SIZE)), 65535)",
