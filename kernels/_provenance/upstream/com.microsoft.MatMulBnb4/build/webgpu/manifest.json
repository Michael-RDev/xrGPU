          "shader": "cast-scalar-x4.wgsl.jinja",
          "derive": { "outScalar": "\"f16\"" },
          "bindings": [
            { "scratch": "yF32", "name": "x", "buffer": "read-only-storage", "elementType": "f32" },
            { "arg": "yT", "name": "y", "elementType": "$srcScalar" },
            { "name": "params", "struct": [{ "name": "count", "type": "u32", "value": "numel(shapes.yT)" }] }
          ],
          "dispatch": {
            "x": "min(ceilDiv((ceilDiv(numel(shapes.yT), 4)), (tunables.WORKGROUP_SIZE)), 65535)",
            "y": "ceilDiv(ceilDiv((ceilDiv(numel(shapes.yT), 4)), (tunables.WORKGROUP_SIZE)), 65535)",
            "z": 1
          }
        }
      ]
    },
    {
      "id": "sgmat_staged_rows",
      "priority": 19,
      "when": ["commonShapeValid", "dim(shapes.aT, 0) > 1", "dim(shapes.aT, 0) < sgmatTileRows or dim(shapes.aT, 0) % sgmatTileRows != 0", "stagedGeometryValid", "attrs.N % tunables.SGMAT_TILE_COLS == 0", "attrs.K % tunables.SGMAT_TILE_K == 0", "attrs.K % attrs.block_size == 0", "attrs.block_size % sgmatLoadWidth == 0", "wave32Effective", "stagedResourcesFit"],
      "requires": {
        "features": ["subgroups", "chromium-experimental-subgroup-matrix"],
        "subgroupMatrixConfigs": [{ "componentType": "f32", "resultComponentType": "f32", "M": 8, "N": 8, "K": 8 }]
      },
      "derive": {
        "tileRows": "stagedTileRows",
        "subRows": "sgmatMatrixSize",
        "subCols": "stagedSubCols",
        "rowMatrices": 1,
        "colMatrices": "stagedColumnMatrices",
        "rowSubtiles": "stagedRowSubtiles",
        "workgroupSize": "stagedWorkgroupSize",
        "stageActivations": true,
        "rowCount": "dim(shapes.aT, 0)"
      },
      "passes": [
        {
          "id": "main",
          "shader": "matmul-bnb4-sgmat.wgsl.jinja",
          "bindings": ["a", "b", "absmax", "y"],
          "dispatch": { "x": "sgmatDispatchN", "y": "ceilDiv(dim(shapes.aT, 0), stagedTileRows)" }
        }
      ]
    },
    {
      "id": "gemv",
