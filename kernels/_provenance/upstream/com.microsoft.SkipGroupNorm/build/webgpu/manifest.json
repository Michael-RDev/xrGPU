            "rowsPerStepSpec": "applyRowsPerStep",
            "wgSpec": "applyWorkgroup",
            "splitSpec": "applySplit",
            "rowsPerSlabSpec": "ceilDiv(dimHW, applySlabCount)",
            "groupUniform": "(channelsPerGroup % applyVecWidth == 0) if channelsLast else true",
            "storeElement": "applyElement",
            "vecF32": "\"vec4<f32>\" if applyVec4Ok else \"f32\"",
            "unitsSpec": "applyUnits",
            "applySrc": "\"src\""
          },
          "bindings": ["srcApplyS", "gamma", "beta", "statsR", "yOut"],
          "dispatch": { "x": "min(applyUnits, 65535)", "y": "ceilDiv(applyUnits, 65535)", "z": 1 }
        }
      ]
    },
    {
      "id": "fused_bias_sum",
      "priority": 10,
      "when": ["fusedFits", "present.bias", "present.S"],
      "derive": {
        "statsElement": "fusedElement",
        "phaseLayout": "channelsLast",
        "hasSkip": "true",
        "hasBias": "true",
        "broadcastSkip": "broadcastSkipSpec",
