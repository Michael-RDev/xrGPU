        "cpgSpec": "channelsPerGroup",
        "groupsSpec": "numGroups",
        "groupSizeSpec": "groupSize",
        "normRowsSpec": "normRows",
        "epsilonSpec": "attrs.epsilon",
        "activationSpec": "activationKind",
        "chunksSpec": "fusedRowChunks",
        "fusedChunksSpec": "fusedChunks",
        "fusedRowsSpec": "max(1, floor(fusedWorkgroup / fusedChunks))",
        "spanVecsSpec": "max(1, floor(groupSize / fusedVecWidth))",
        "wgSpec": "fusedWorkgroup",
        "ldsSpec": "fusedLanes",
        "vecF32": "\"vec4<f32>\" if statsVec4Ok else \"f32\"",
        "storeElement": "fusedElement",
        "fusedSrc": "\"sum_dst\"",
        "planeVecsSpec": "planeVecs",
        "skipElement": "tScalar if broadcastSkipSpec else fusedElement"
      },
      "passes": [
        {
          "id": "main",
          "name": "GroupNorm.Fused",
          "shader": "group-norm-fused.wgsl.jinja",
          "bindings": ["xIn", "skipIn", "gamma", "beta", "sumDstS", "yFused"],
          "dispatch": { "x": "min(normRows, 65535)", "y": "ceilDiv(normRows, 65535)", "z": 1 }
        }
      ]
    },
    {
      "id": "split_plain",
      "priority": 20,
      "when": ["splitFits", "not present.bias", "not present.S"],
      "demoteWhen": ["elementCount < tunables.SPLIT_MIN_ELEMENTS * statsGroupBlocks", "(not channelsLast) and normRows >= tunables.FUSED_MIN_ROWS and groupSize * dtypeBytes(tensorDtypes.X) <= tunables.FUSED_MAX_GROUP_BYTES"],
      "derive": {
        "phaseLayout": "channelsLast",
        "hasSkip": "true",
        "hasBias": "false",
        "broadcastSkip": "broadcastSkipSpec",
        "vecSpec": "statsVecWidth",
        "dimCSpec": "dimC",
        "dimHWSpec": "dimHW",
        "cpgSpec": "channelsPerGroup",
        "groupsSpec": "numGroups",
        "groupSizeSpec": "groupSize",
        "normRowsSpec": "normRows",
        "epsilonSpec": "attrs.epsilon",
        "activationSpec": "activationKind",
        "chunksSpec": "statsChunks",
        "rowsPerStepSpec": "statsRowsPerStep",
        "splitSpec": "splitCount",
        "rowsPerSlabSpec": "ceilDiv(dimHW, slabCount)",
        "planeVecsSpec": "planeVecs",
        "chunkVecsSpec": "ceilDiv(planeVecs, planeSplits)",
        "partialsPerRowSpec": "partialsPerRow",
        "wgSpec": "statsWorkgroup",
        "combineWgSpec": "combineWorkgroup",
        "vecF32": "(\"vec\" ~ statsVecWidth ~ \"<f32>\") if statsVecWidth > 1 else \"f32\"",
        "storeElement": "statsElement",
        "applySrc": "\"Y\"",
        "groupUniform": "true"
      },
      "intermediates": [
        { "id": "partials", "dtype": "float32", "shape": "[partialElements, 2]" },
        { "id": "stats", "dtype": "float32", "shape": "[statsElements, 2]" }
      ],
      "passes": [
        {
          "id": "stats",
          "name": "GroupNorm.Partials",
          "shader": "group-norm-slab.wgsl.jinja",
          "derive": {
            "phase": "\"stats\"",
            "unitsSpec": "workUnits",
            "statsBlockedSpec": "channelsLast and statsGroupBlocks > 1",
            "statsGroupsPerBlockSpec": "statsGroupsPerBlock",
            "statsGroupBlocksSpec": "statsGroupBlocks",
            "statsTileChunksSpec": "statsTileChunks"
          },
          "bindings": ["xIn", "skipIn", "sumDstY", "partialsW"],
          "dispatch": { "x": "min(workUnits, 65535)", "y": "ceilDiv(workUnits, 65535)", "z": 1 }
        },
        {
          "id": "combine",
          "name": "GroupNorm.Combine",
          "shader": "group-norm-combine.wgsl.jinja",
          "bindings": ["srcCombineY", "partialsR", "statsW"],
          "dispatch": {
            "x": "min(ceilDiv((normRows), (combineWorkgroup)), 65535)",
            "y": "ceilDiv(ceilDiv((normRows), (combineWorkgroup)), 65535)",
            "z": 1
          }
        },
        {
          "id": "apply",
          "name": "GroupNorm.Apply",
          "shader": "group-norm-slab.wgsl.jinja",
          "derive": {
            "phase": "\"apply\"",
            "vecSpec": "applyVecWidth",
            "chunksSpec": "applyChunks",
            "rowsPerStepSpec": "applyRowsPerStep",
            "wgSpec": "applyWorkgroup",
            "splitSpec": "applySplit",
            "rowsPerSlabSpec": "ceilDiv(dimHW, applySlabCount)",
            "groupUniform": "(channelsPerGroup % applyVecWidth == 0) if channelsLast else true",
            "storeElement": "applyElement",
            "vecF32": "\"vec4<f32>\" if applyVec4Ok else \"f32\"",
            "unitsSpec": "applyUnits",
            "applySrc": "\"Y\""
          },
          "bindings": ["gamma", "beta", "statsR", "yOut"],
          "dispatch": { "x": "min(applyUnits, 65535)", "y": "ceilDiv(applyUnits, 65535)", "z": 1 }
        }
      ]
    },
    {
      "id": "fused_plain",
      "priority": 10,
      "when": ["fusedFits", "not present.bias", "not present.S"],
      "derive": {
        "statsElement": "fusedElement",
        "phaseLayout": "channelsLast",
        "hasSkip": "true",
        "hasBias": "false",
        "broadcastSkip": "broadcastSkipSpec",
        "useVec4": "statsVec4Ok",
        "vecSpec": "fusedVecWidth",
        "dimCSpec": "dimC",
        "dimHWSpec": "dimHW",
        "cpgSpec": "channelsPerGroup",
        "groupsSpec": "numGroups",
        "groupSizeSpec": "groupSize",
        "normRowsSpec": "normRows",
        "epsilonSpec": "attrs.epsilon",
        "activationSpec": "activationKind",
        "chunksSpec": "fusedRowChunks",
        "fusedChunksSpec": "fusedChunks",
        "fusedRowsSpec": "max(1, floor(fusedWorkgroup / fusedChunks))",
        "spanVecsSpec": "max(1, floor(groupSize / fusedVecWidth))",
        "wgSpec": "fusedWorkgroup",
        "ldsSpec": "fusedLanes",
        "vecF32": "\"vec4<f32>\" if statsVec4Ok else \"f32\"",
        "storeElement": "fusedElement",
        "fusedSrc": "\"Y\"",
        "planeVecsSpec": "planeVecs",
        "skipElement": "tScalar if broadcastSkipSpec else fusedElement"
      },
      "passes": [
        {
          "id": "main",
          "name": "GroupNorm.Fused",
          "shader": "group-norm-fused.wgsl.jinja",
          "bindings": ["xIn", "skipIn", "gamma", "beta", "yFused"],
          "dispatch": { "x": "min(normRows, 65535)", "y": "ceilDiv(normRows, 65535)", "z": 1 }
        }
      ]
    }
  ]
}
