        "partialsPerRowSpec": "partialsPerRow",
        "wgSpec": "statsWorkgroup",
        "combineWgSpec": "combineWorkgroup",
        "vecF32": "(\"vec\" ~ statsVecWidth ~ \"<f32>\") if statsVecWidth > 1 else \"f32\"",
        "storeElement": "statsElement",
        "applySrc": "\"Y\"",
        "groupUniform": "true"
