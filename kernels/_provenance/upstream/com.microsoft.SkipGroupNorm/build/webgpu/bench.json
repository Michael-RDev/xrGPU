        "S": { "dtype": "float16", "shape": [2, 64, 64, 448], "dist": "empty" }
      },
      "bench": {
        "metrics": [
          {
            "type": "bandwidth",
            "value": "(args.count * args.streams + args.skipElements) * dtypeBytes(args.dtype) + args.channels * 2 * dtypeBytes(args.weightDtype)"
          }
        ]
      }
    }
  ]
}
