            "y": "numHeads",
            "z": "ceilDiv(clusterTiles, DISPATCH_FOLD_WIDTH)"
          }
        }
      ],
      "requires": { "features": ["subgroups"] },
      "demoteWhen": ["vHeadDim != headDim and (tokenCount < clusterLpq or (clusterUseDistributed and portableLpq > clusterLpq))"]
