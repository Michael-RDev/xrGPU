        "then_value": { "dtype": "float32", "shape": [1048576] },
        "else_value": { "dtype": "float32", "shape": [1048576] }
      },
      "outputs": { "y": { "dtype": "float32", "shape": [1048576] } },
      "bench": {
        "metrics": [
          { "type": "bandwidth", "value": "4 * (numel(shapes.cond) + numel(shapes.then_value) + numel(shapes.y))" }
        ]
      }
    }
  ]
}
