        "e": { "dtype": "float16", "shape": [5], "data": { "kind": "values", "values": [5.0, 6.0, 7.0, 8.0, 9.0] } }
      },
      "outputs": {
        "y": {
          "dtype": "float16",
          "shape": [5],
          "tolerance": 0,
