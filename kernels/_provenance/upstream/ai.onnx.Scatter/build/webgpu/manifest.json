{
  "domain": "ai.onnx",
  "name": "Scatter",
  "sinceVersion": 11,
  "inputs": { "data": { "dtype": "T" }, "indices": { "dtype": "I" }, "updates": { "dtype": "T" } },
  "outputs": { "output": { "dtype": "T", "rank": "ranks.data", "shape": "shapes.data" } },
  "attributes": { "axis": { "default": 0 } },
  "typeConstraints": {
    "T": ["float32", "float16", "int32", "int16", "int8", "uint32", "uint8", "bool"],
    "I": ["int32"]
  },
  "tunables": { "WORKGROUP_SIZE": { "default": 256 } },
  "variants": [
    {
      "id": "generic",
      "when": ["ranks.data == ranks.output", "ranks.indices == ranks.updates", "ranks.data >= 1", "ranks.indices == ranks.data", "attrs.axis + ranks.data >= 0", "attrs.axis < ranks.data", "numel(shapes.data) == numel(shapes.output)", "numel(shapes.indices) == numel(shapes.updates)", "f16Ok(dtypes.T)"],
      "derive": {
        "scalar": "dtypes.T",
        "indexScalar": "dtypes.I",
        "copyElementType": "(\"vec4<\" ~ dtypes.T ~ \">\") if numel(shapes.output) % 4 == 0 else dtypes.T"
      },
      "passes": [
        {
          "id": "copy",
          "name": "Scatter.Copy",
          "shader": "scatter-flat-copy.wgsl.jinja",
          "derive": { "count": "numel(shapes.output) / 4 if numel(shapes.output) % 4 == 0 else numel(shapes.output)" },
          "bindings": [
            { "arg": "data", "name": "src", "elementType": "$copyElementType" },
            { "arg": "output", "name": "dst", "elementType": "$copyElementType" }
          ],
          "dispatch": {
            "x": "min(ceilDiv((numel(shapes.output) / 4 if numel(shapes.output) % 4 == 0 else numel(shapes.output)), (tunables.WORKGROUP_SIZE)), 65535)",
            "y": "ceilDiv(ceilDiv((numel(shapes.output) / 4 if numel(shapes.output) % 4 == 0 else numel(shapes.output)), (tunables.WORKGROUP_SIZE)), 65535)",
            "z": 1
          }
        },
        {
          "id": "scatter",
          "name": "Scatter.Scatter",
          "shader": "scatter.wgsl.jinja",
          "derive": {
            "dataShape": "shapes.data",
            "updatesShape": "shapes.updates",
            "rank": "ranks.data",
            "axisSpec": "attrs.axis if attrs.axis >= 0 else attrs.axis + ranks.data"
          },
          "bindings": [
            { "arg": "indices", "elementType": "$indexScalar" },
            { "arg": "updates", "elementType": "$scalar" },
            { "arg": "output", "elementType": "$scalar" },
            {
              "name": "params",
              "struct": [
                { "name": "count", "type": "u32", "value": "numel(shapes.updates)" },
                {
                  "name": "axisDim",
                  "type": "u32",
                  "value": "dim(shapes.data, attrs.axis if attrs.axis >= 0 else attrs.axis + ranks.data)"
                }
              ]
            }
          ],
          "dispatch": {
            "x": "min(ceilDiv((numel(shapes.updates)), (tunables.WORKGROUP_SIZE)), 65535)",
            "y": "ceilDiv(ceilDiv((numel(shapes.updates)), (tunables.WORKGROUP_SIZE)), 65535)",
            "z": 1
          }
        }
      ]
    }
  ]
}
