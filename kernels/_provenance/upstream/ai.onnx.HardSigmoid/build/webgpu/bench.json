{
  "cases": [
    {
      "name": "1m_f32",
      "preset": "smoke",
      "inputs": { "x": { "dtype": "float32", "shape": [1048576] } },
      "outputs": { "y": { "dtype": "float32", "shape": [1048576] } },
      "bench": { "metrics": [{ "type": "bandwidth", "value": "(numel(shapes.x) + numel(shapes.y)) * 4" }] }
    },
    {
      "name": "hardsigmoid-f32-1m",
      "preset": "edge",
      "vars": { "dtype": "float32", "count": 1048575 },
      "inputs": {
        "x": { "shape": [1048575], "dtype": "float32", "dist": "uniform", "seed": 5301, "scale": 20, "offset": -10 }
      },
      "outputs": { "y": { "shape": [1048575], "dtype": "float32" } },
      "bench": {
        "primary": true,
        "metrics": [{ "type": "bandwidth", "value": "args.count * dtypeBytes(args.dtype) * 2" }]
      }
    }
  ]
}
