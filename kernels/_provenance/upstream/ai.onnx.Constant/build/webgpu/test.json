    {
      "name": "literal_non_finite_values",
      "provenance": {
        "notes": "WGSL has no non-finite numeric literals, so a constant containing NaN or Infinity is represented as bit patterns and bitcast at read time. Finite 1.5 and negative zero verify that the bit-pattern representation also preserves ordinary values and the zero sign bit."
      },
      "attrs": { "value": { "dtype": "float32", "shape": [5], "values": ["NaN", "Infinity", "-Infinity", -0, 1.5] } },
      "inputs": {},
      "outputs": {
        "output": {
          "dtype": "float32",
          "shape": [5],
          "tolerance": 0,
          "data": { "kind": "values", "values": ["NaN", "Infinity", "-Infinity", -0.0, 1.5] },
          "allowNaN": true
        }
      }
