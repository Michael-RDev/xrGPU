{
  "tunableSpace": { "WORKGROUP_SIZE": [64, 128, 256, 512], "LANE_WORDS": [1, 2, 4, 8] },
  "cases": [
    {
      "name": "gated-rmsnorm-decode-h16-d128-f32",
      "preset": "smoke",
      "provenance": {
        "model": "Qwen3.5 / Qwen3-Next gated linear attention output norm",
        "notes": "One decoded token: 16 value heads of 128. The whole operator is 24 KB of traffic, so the measurement is launch latency rather than bandwidth."
      },
      "vars": { "dtype": "float32", "count": 2048, "span": 128 },
      "inputs": {
        "xT": { "shape": [1, 1, 2048], "dtype": "float32", "dist": "normal", "seed": 501, "scale": 1 },
        "scaleT": { "shape": [128], "dtype": "float32", "dist": "uniform", "seed": 502, "min": 0.2, "max": 1.8 },
        "gateT": { "shape": [1, 1, 2048], "dtype": "float32", "dist": "normal", "seed": 503, "scale": 2 }
      },
      "outputs": { "yT": { "shape": [1, 1, 2048], "dtype": "float32" } },
      "bench": {
        "metrics": [{ "type": "bandwidth", "value": "(args.count * 3 + args.span) * dtypeBytes(args.dtype)" }]
      }
    },
