{
  "tunableSpace": { "WORKGROUP_SIZE": [64, 128, 256] },
  "cases": [
    {
      "name": "1m_f32",
      "inputs": { "x": { "dtype": "float32", "shape": [1048576] } },
      "outputs": { "y": { "dtype": "float32", "shape": [1048576] } }
    },
    {
      "name": "swish-f32-8m",
      "preset": "smoke",
      "vars": { "dtype": "float32", "count": 8388608 },
      "inputs": { "x": { "shape": [8388608], "dtype": "float32", "seed": 7027, "dist": "normal", "scale": 2 } },
      "outputs": { "y": { "shape": [8388608], "dtype": "float32" } },
      "bench": { "metrics": [{ "type": "bandwidth", "value": "args.count * dtypeBytes(args.dtype) * 2" }] }
    },
    {
      "name": "swish-f16-8m",
      "preset": "smoke",
      "vars": { "dtype": "float16", "count": 8388608 },
      "inputs": { "x": { "shape": [8388608], "dtype": "float16", "seed": 7028, "dist": "normal", "scale": 2 } },
      "outputs": { "y": { "shape": [8388608], "dtype": "float16" } },
      "bench": { "metrics": [{ "type": "bandwidth", "value": "args.count * dtypeBytes(args.dtype) * 2" }] }
    },
    {
      "name": "swish-f32-8m-plus-1-scalar",
      "preset": "edge",
      "vars": { "dtype": "float32", "count": 8388609 },
      "inputs": { "x": { "shape": [8388609], "dtype": "float32", "dist": "normal", "seed": 7301, "scale": 2 } },
      "outputs": { "y": { "shape": [8388609], "dtype": "float32" } },
      "bench": { "metrics": [{ "type": "bandwidth", "value": "args.count * dtypeBytes(args.dtype) * 2" }] }
    }
  ]
}
