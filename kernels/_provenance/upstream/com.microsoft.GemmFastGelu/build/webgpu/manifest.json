          "dispatch": { "x": "gemvWorkgroups" }
        }
      ]
    },
    {
      "id": "sgmat_medium_bias",
      "priority": 120,
      "when": ["biasContract", "sgmatMediumContract", "tensorDtypes.X == \"float32\""],
      "requires": {
        "features": ["subgroups", "chromium-experimental-subgroup-matrix"],
        "subgroupMatrixConfigs": [{ "componentType": "f32", "M": 8, "N": 8, "K": 8, "resultComponentType": "f32" }]
      },
      "derive": {
        "hasBias": true,
        "xScalar": "\"f32\"",
        "wScalar": "\"f32\"",
        "bScalar": "\"f32\"",
        "yScalar": "\"f32\"",
        "mmaScalar": "\"f32\"",
        "inFeatures": "kDim",
        "outFeatures": "nDim",
        "tileM": "sgmatMediumRows",
        "tileN": "sgmatMediumCols",
        "directAStorage": true,
        "doubleBufferedB": true,
        "balancedMatrixAccumulation": true
      },
      "passes": [
        {
          "id": "main",
          "name": "GemmFastGelu.SgmatMediumBias",
          "shader": "gemm-subgroup-matrix.wgsl.jinja",
          "bindings": ["x", "w", { "arg": "bias", "elementType": "$bScalar" }, "y", "params"],
          "dispatch": {
            "x": "ceilDiv(nDim, tileN)",
            "y": "min(ceilDiv(gfgRows, tileM), DISPATCH_FOLD_WIDTH)",
            "z": "ceilDiv(ceilDiv(gfgRows, tileM), DISPATCH_FOLD_WIDTH)"
          }
        }
      ],
      "demoteWhen": ["sgmatOutputGroups > (tunables.MEDIUM_MATRIX_MAX_GROUPS_F16 if usesF16 else tunables.MEDIUM_MATRIX_MAX_GROUPS_F32) and (sgmatDirectContract or sgmatContract)"]
    },
