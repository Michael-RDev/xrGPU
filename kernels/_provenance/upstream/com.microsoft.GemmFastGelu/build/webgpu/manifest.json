        "features": ["subgroups", "chromium-experimental-subgroup-matrix"],
        "subgroupMatrixConfigs": [{ "componentType": "f32", "M": 8, "N": 8, "K": 8, "resultComponentType": "f32" }]
      },
      "derive": {
        "hasBias": false,
        "xScalar": "\"f32\"",
