{
  "tunableSpace": { "WORKGROUP_SIZE": [64, 128, 256] },
  "cases": [
    {
      "name": "flatten-f32-1m",
      "preset": "smoke",
      "vars": { "dtype": "float32", "count": 1048576 },
      "inputs": { "input": { "shape": [256, 4096], "dtype": "float32", "dist": "normal", "seed": 830, "scale": 1 } },
      "outputs": { "output": { "shape": [256, 4096], "dtype": "float32" } },
      "bench": {
        "primary": true,
        "metrics": [{ "type": "bandwidth", "value": "args.count * dtypeBytes(args.dtype) * 2" }]
      }
    },
    {
      "name": "flatten-u32-bool-like-1m",
      "preset": "edge",
      "vars": { "dtype": "uint32", "count": 1048576 },
      "inputs": { "input": { "shape": [256, 4096], "dtype": "uint32", "dist": "linearMod", "mod": 2 } },
      "outputs": { "output": { "shape": [256, 4096], "dtype": "uint32" } },
      "bench": { "metrics": [{ "type": "bandwidth", "value": "args.count * dtypeBytes(args.dtype) * 2" }] }
    },
    {
      "name": "flatten-f32-16m",
      "preset": "smoke",
      "vars": { "dtype": "float32", "count": 16777216 },
      "inputs": { "input": { "shape": [4096, 4096], "dtype": "float32", "dist": "normal", "seed": 831, "scale": 1 } },
      "outputs": { "output": { "shape": [4096, 4096], "dtype": "float32" } },
      "bench": { "metrics": [{ "type": "bandwidth", "value": "args.count * dtypeBytes(args.dtype) * 2" }] }
    },
    {
      "name": "flatten-f32-scalar-copy-1m-odd",
      "preset": "edge",
      "attrs": { "axis": 1 },
      "vars": { "dtype": "float32", "count": 1048577 },
      "inputs": { "input": { "shape": [1, 1048577], "dtype": "float32", "dist": "normal", "seed": 832, "scale": 1 } },
      "outputs": { "output": { "shape": [1, 1048577], "dtype": "float32", "dist": "empty" } },
      "bench": { "metrics": [{ "type": "bandwidth", "value": "args.count * dtypeBytes(args.dtype) * 2" }] }
    }
  ]
}
