{
  "domain": "ai.onnx",
  "name": "AffineGrid",
  "sinceVersion": 20,
  "inputs": { "theta": { "dtype": "T", "rank": 3 } },
  "outputs": { "grid": { "dtype": "T", "rank": "4 if dim(shapes.theta, 1) == 2 else 5" } },
  "attributes": { "align_corners": { "default": 0 } },
  "attributeConstraints": { "align_corners": { "values": [0, 1] } },
  "typeConstraints": { "T": ["float32", "float16"] },
  "tunables": { "WORKGROUP_SIZE": { "default": 256 } },
  "derive": {
    "dtypeSupported": "f16Ok(dtypes.T)",
    "grid2dContract": "dtypeSupported and ranks.theta == 3 and ranks.grid == 4 and dim(shapes.theta, 1) == 2 and dim(shapes.theta, 2) == 3 and dim(shapes.grid, 0) == dim(shapes.theta, 0) and dim(shapes.grid, 3) == 2",
    "grid3dContract": "dtypeSupported and ranks.theta == 3 and ranks.grid == 5 and dim(shapes.theta, 1) == 3 and dim(shapes.theta, 2) == 4 and dim(shapes.grid, 0) == dim(shapes.theta, 0) and dim(shapes.grid, 4) == 3",
    "scalar": "dtypes.T",
    "usesF16": "dtypes.T == \"f16\""
  },
  "variants": [
    {
      "id": "3d_w4",
      "priority": 20,
      "when": ["grid3dContract", "dim(shapes.grid, 3) > 0", "dim(shapes.grid, 3) % 4 == 0"],
      "derive": { "vectorScalar": "\"vec4<\" ~ dtypes.T ~ \">\"" },
      "passes": [
        {
          "id": "main",
          "name": "AffineGrid3D.W4",
          "shader": "affine-grid3d-w4.wgsl.jinja",
          "derive": {
            "alignCorners": "attrs.align_corners != 0",
            "count4": "numel(shapes.grid) / 3 / 4",
            "D": "dim(shapes.grid, 1)",
            "H": "dim(shapes.grid, 2)",
            "W": "dim(shapes.grid, 3)",
            "W4": "dim(shapes.grid, 3) / 4"
          },
          "bindings": ["theta", { "arg": "grid", "elementType": "$vectorScalar" }],
          "dispatch": {
            "x": "min(ceilDiv((numel(shapes.grid) / 3 / 4), (tunables.WORKGROUP_SIZE)), 65535)",
            "y": "ceilDiv(ceilDiv((numel(shapes.grid) / 3 / 4), (tunables.WORKGROUP_SIZE)), 65535)",
            "z": 1
          }
        }
      ]
    },
    {
      "id": "2d",
      "when": ["grid2dContract"],
      "passes": [
        {
          "id": "main",
          "name": "AffineGrid",
          "shader": "affine-grid.wgsl.jinja",
          "derive": { "alignCorners": "attrs.align_corners != 0", "spatialRankSpec": 2 },
          "bindings": [
            "theta",
            "grid",
            {
              "name": "params",
              "struct": [
                { "name": "count", "type": "u32", "value": "numel(shapes.grid) / 2" },
                { "name": "H", "type": "u32", "value": "dim(shapes.grid, 1)" },
                { "name": "W", "type": "u32", "value": "dim(shapes.grid, 2)" }
              ]
            }
          ],
          "dispatch": {
            "x": "min(ceilDiv((numel(shapes.grid) / 2), (tunables.WORKGROUP_SIZE)), 65535)",
            "y": "ceilDiv(ceilDiv((numel(shapes.grid) / 2), (tunables.WORKGROUP_SIZE)), 65535)",
            "z": 1
          }
        }
      ]
    },
    {
      "id": "3d",
      "priority": 10,
      "when": ["grid3dContract"],
      "passes": [
        {
          "id": "main",
          "name": "AffineGrid3D",
          "shader": "affine-grid.wgsl.jinja",
          "derive": { "alignCorners": "attrs.align_corners != 0", "spatialRankSpec": 3 },
          "bindings": [
            "theta",
            "grid",
            {
              "name": "params",
              "struct": [
                { "name": "count", "type": "u32", "value": "numel(shapes.grid) / 3" },
                { "name": "D", "type": "u32", "value": "dim(shapes.grid, 1)" },
                { "name": "H", "type": "u32", "value": "dim(shapes.grid, 2)" },
                { "name": "W", "type": "u32", "value": "dim(shapes.grid, 3)" }
              ]
            }
          ],
          "dispatch": {
            "x": "min(ceilDiv((numel(shapes.grid) / 3), (tunables.WORKGROUP_SIZE)), 65535)",
            "y": "ceilDiv(ceilDiv((numel(shapes.grid) / 3), (tunables.WORKGROUP_SIZE)), 65535)",
            "z": 1
          }
        }
      ]
    }
  ]
}
