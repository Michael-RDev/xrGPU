{
  "tunableSpace": { "WORKGROUP_SIZE": [64, 128, 256] },
  "cases": [
    {
      "name": "squeeze-f32-1m",
      "preset": "smoke",
      "vars": { "dtype": "float32", "count": 1048576 },
      "inputs": { "data": { "shape": [1, 1048576, 1], "dtype": "float32", "dist": "normal", "seed": 840, "scale": 1 } },
      "outputs": { "squeezed": { "shape": [1048576], "dtype": "float32" } },
      "bench": {
        "primary": true,
        "metrics": [{ "type": "bandwidth", "value": "args.count * dtypeBytes(args.dtype) * 2" }]
      }
    },
    {
      "name": "squeeze-f32-16m",
      "preset": "smoke",
      "vars": { "dtype": "float32", "count": 16777216 },
      "inputs": { "data": { "shape": [1, 16777216, 1], "dtype": "float32", "dist": "normal", "seed": 841, "scale": 1 } },
      "outputs": { "squeezed": { "shape": [16777216], "dtype": "float32" } },
      "bench": { "metrics": [{ "type": "bandwidth", "value": "args.count * dtypeBytes(args.dtype) * 2" }] }
    },
    {
      "name": "squeeze-f32-scalar-copy-1m-odd",
      "preset": "edge",
      "vars": { "dtype": "float32", "count": 1048577 },
      "inputs": { "data": { "shape": [1, 1048577, 1], "dtype": "float32", "dist": "normal", "seed": 842, "scale": 1 } },
      "outputs": { "squeezed": { "shape": [1048577], "dtype": "float32", "dist": "empty" } },
      "bench": { "metrics": [{ "type": "bandwidth", "value": "args.count * dtypeBytes(args.dtype) * 2" }] }
    }
  ]
}
