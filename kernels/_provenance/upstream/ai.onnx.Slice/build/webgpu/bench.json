      "outputs": { "output": { "dtype": "float16", "shape": [3072, 2048] } },
      "bench": {
        "metrics": [{ "type": "bandwidth", "value": "args.outRows * args.cols * dtypeBytes(args.dtype) * 2" }]
      }
    },
    {
      "name": "slice-inner-true-misaligned-f32-4096x4097",
      "preset": "edge",
      "vars": { "rows": 4096, "outCols": 4097 },
