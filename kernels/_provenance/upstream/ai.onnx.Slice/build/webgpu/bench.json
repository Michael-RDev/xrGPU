    },
    {
      "name": "slice-no-axes-no-steps-f32-4096x4096",
      "preset": "edge",
      "vars": { "outRows": 3584, "cols": 4096 },
      "inputs": {
        "data": { "dtype": "float32", "shape": [4096, 4096], "dist": "normal", "seed": 142, "scale": 0.5 },
