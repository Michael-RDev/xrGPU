        "ends": { "dtype": "int32", "shape": [1], "dist": "constant", "value": 1920 },
        "axes": { "dtype": "int32", "shape": [1], "dist": "constant", "value": 0 },
        "steps": { "dtype": "int32", "shape": [1], "dist": "constant", "value": 1 }
