      },
      "vars": { "dtype": "float32", "elems": 2097152, "cacheElems": 32768 },
      "inputs": {
        "x": { "shape": [1, 512, 4096], "dtype": "float32", "dist": "normal", "seed": 4010, "scale": 1 },
        "positionIds": {
          "shape": [1, 512],
          "dtype": "uint32",
          "dist": "linearMod",
          "seed": 4010,
          "step": 1,
          "offset": 0,
          "mod": 4096
        },
        "cos": { "shape": [4096, 64], "dtype": "float32", "dist": "uniform", "seed": 4011, "scale": 0.1, "offset": 0.9 },
