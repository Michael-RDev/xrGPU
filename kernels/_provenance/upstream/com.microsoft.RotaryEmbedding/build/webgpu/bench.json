      "name": "llama3-8b-prefill-s512-q-h32-d128-f32",
      "preset": "smoke",
      "attrs": { "interleaved": 0 },
      "provenance": {
        "notes": "512-token prefill of the query projection: rank-3 packed heads with a rank-2 cache and a per-token position table. Read-once, write-once traffic.",
