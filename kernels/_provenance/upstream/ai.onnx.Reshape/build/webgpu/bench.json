{
  "tunableSpace": { "WORKGROUP_SIZE": [64, 128, 256] },
  "cases": [
    {
      "name": "reshape-f32-1m",
      "preset": "smoke",
      "vars": { "dtype": "float32", "count": 1048576 },
      "inputs": {
        "data": { "shape": [1024, 1024], "dtype": "float32", "dist": "normal", "seed": 820, "scale": 1 },
        "shape": { "shape": [1], "dtype": "int32", "data": { "kind": "values", "values": [1048576] } }
      },
      "outputs": { "reshaped": { "shape": [1048576], "dtype": "float32" } },
      "bench": {
        "primary": true,
        "metrics": [{ "type": "bandwidth", "value": "args.count * dtypeBytes(args.dtype) * 2" }]
      }
    },
    {
      "name": "reshape-f32-16m",
      "preset": "smoke",
      "vars": { "dtype": "float32", "count": 16777216 },
      "inputs": {
        "data": { "shape": [4096, 4096], "dtype": "float32", "dist": "normal", "seed": 821, "scale": 1 },
        "shape": { "shape": [1], "dtype": "int32", "data": { "kind": "values", "values": [16777216] } }
      },
      "outputs": { "reshaped": { "shape": [16777216], "dtype": "float32" } },
      "bench": { "metrics": [{ "type": "bandwidth", "value": "args.count * dtypeBytes(args.dtype) * 2" }] }
    },
    {
      "name": "reshape-f32-scalar-copy-1m-odd",
      "preset": "edge",
      "vars": { "dtype": "float32", "count": 1048575 },
      "inputs": {
        "data": { "shape": [3, 349525], "dtype": "float32", "dist": "normal", "seed": 822, "scale": 1 },
        "shape": { "shape": [1], "dtype": "int32", "data": { "kind": "values", "values": [1048575] } }
      },
      "outputs": { "reshaped": { "shape": [1048575], "dtype": "float32", "dist": "empty" } },
      "bench": { "metrics": [{ "type": "bandwidth", "value": "args.count * dtypeBytes(args.dtype) * 2" }] }
    }
  ]
}
