{
  "cases": [
    {
      "name": "isnan-f32-1m",
      "preset": "smoke",
      "inputs": { "x": { "dtype": "float32", "shape": [1048576], "dist": "normal", "seed": 910, "scale": 1 } },
      "outputs": { "y": { "dtype": "bool", "shape": [1048576] } },
      "bench": { "metrics": [{ "type": "bandwidth", "value": "(numel(shapes.x) + numel(shapes.y)) * 4" }] }
