{
  "domain": "ai.onnx",
  "name": "Size",
  "sinceVersion": 13,
  "inputs": { "data": { "dtype": "T" } },
  "outputs": { "size": { "dtype": "S", "rank": 0, "shape": [], "storage": "uint32" } },
  "typeConstraints": {
    "T": ["float32", "float16", "int32", "uint32", "int16", "int8", "uint8", "bool"],
    "S": ["int64"]
  },
  "variants": [
    {
      "id": "u32_scalar",
      "when": ["ranks.size == 0"],
      "passes": [
        {
          "id": "main",
          "name": "Size",
          "shader": "size.wgsl.jinja",
          "bindings": [
            { "arg": "size", "length": 1 },
            { "name": "params", "struct": [{ "name": "count", "type": "u32", "value": "numel(shapes.data)" }] }
          ],
          "dispatch": { "x": 1 }
        }
      ]
    }
  ]
}
