          "shader": "qkv-projection.wgsl.jinja",
          "derive": { "singleProjection": "\"k\"" },
          "bindings": ["normed_q", "k_b", "k_scales", "k"],
          "dispatch": { "x": "ceilDiv(attrs.Nkv, tileCols)", "y": "rowGroups" }
