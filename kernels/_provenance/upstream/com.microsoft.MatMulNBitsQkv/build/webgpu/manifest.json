          "shader": "matmul-nbits-fused-rms-norm.wgsl.jinja",
          "bindings": ["a", "skip", "norm_scale", "normed", "params"],
          "dispatch": { "x": "min(aRows, 65535)", "y": "ceilDiv(aRows, 65535)", "z": 1 }
        },
        {
