          "derive": { "singleProjection": "\"v\"" },
          "bindings": ["normed_q", "v_b", "v_scales", "v"],
          "dispatch": { "x": "ceilDiv(attrs.Nkv, tileCols)", "y": "rowGroups" }
        }
      ]
    },
    {
