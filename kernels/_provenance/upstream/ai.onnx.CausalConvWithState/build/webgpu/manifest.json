          "bindings": ["input_main", "weight_main", "bias", "output_main", "present_state", "params"],
          "dispatch": {
            "x": "min(dim(shapes.outputT, 0) * dim(shapes.outputT, 1) * ceilDiv(dim(shapes.outputT, 2), tileSize), 65535)",
