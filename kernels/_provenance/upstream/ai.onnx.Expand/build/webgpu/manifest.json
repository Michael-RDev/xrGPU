{
  "domain": "ai.onnx",
  "name": "Expand",
  "sinceVersion": 13,
  "inputs": {
    "input": { "dtype": "T" },
    "shape": { "dtype": "S", "rank": 1, "storage": "uint32", "narrowing": "checked" }
  },
  "outputs": { "output": { "dtype": "T", "rank": "dim(shapes.shape, 0)" } },
  "typeConstraints": {
    "T": ["float32", "float16", "uint32", "int32", "int16", "uint8", "int8", "bool", "int64"],
    "S": ["int64"]
  },
  "tunables": { "WORKGROUP_SIZE": { "default": 256 } },
  "derive": {
    "scalar": "dtypes.T",
    "vectorScalar": "\"vec4<\" ~ dtypes.T ~ \">\"",
    "xShape": "shapes.input",
    "yShape": "shapes.output",
    "xRank": "ranks.input",
    "yRank": "ranks.output"
  },
  "when": ["ranks.input <= ranks.output", "f16Ok(dtypes.T)"],
  "bindings": {
    "x": { "arg": "input", "elementType": "$scalar" },
    "y": { "arg": "output", "elementType": "$vectorScalar" },
    "params": { "struct": [{ "name": "count", "type": "u32", "value": "numel(shapes.output) / 4" }] }
  },
  "variants": [
    {
      "id": "broadcast_vec4",
      "priority": 10,
      "when": ["dtypes.T != \"vec2<u32>\"", "ranks.output >= 1", "dim(shapes.output, -1) % 4 == 0"],
      "passes": [
        {
          "id": "main",
          "name": "Expand.Vec4",
          "shader": "expand-vec4.wgsl.jinja",
          "derive": { "rowAligned": "true" },
          "bindings": ["x", "y", "params"],
          "dispatch": {
            "x": "min(ceilDiv((numel(shapes.output) / 4), (tunables.WORKGROUP_SIZE)), 65535)",
            "y": "ceilDiv(ceilDiv((numel(shapes.output) / 4), (tunables.WORKGROUP_SIZE)), 65535)",
            "z": 1
          }
        }
      ]
    },
    {
      "id": "broadcast_vec4_unaligned",
      "priority": 10,
      "when": ["dtypes.T != \"vec2<u32>\"", "ranks.output >= 1", "dim(shapes.output, -1) % 4 != 0", "numel(shapes.output) % 4 == 0"],
      "passes": [
        {
          "id": "main",
          "name": "Expand.Vec4Unaligned",
          "shader": "expand-vec4.wgsl.jinja",
          "derive": { "rowAligned": "false" },
          "bindings": ["x", "y", "params"],
          "dispatch": {
            "x": "min(ceilDiv((numel(shapes.output) / 4), (tunables.WORKGROUP_SIZE)), 65535)",
            "y": "ceilDiv(ceilDiv((numel(shapes.output) / 4), (tunables.WORKGROUP_SIZE)), 65535)",
            "z": 1
          }
        }
      ]
    },
    {
      "id": "broadcast",
      "passes": [
        {
          "id": "main",
          "name": "Expand",
          "shader": "expand.wgsl.jinja",
          "bindings": [
            "x",
            { "arg": "output", "name": "y", "elementType": "$scalar" },
            { "name": "params", "struct": [{ "name": "count", "type": "u32", "value": "numel(shapes.output)" }] }
          ],
          "dispatch": {
            "x": "min(ceilDiv((numel(shapes.output)), (tunables.WORKGROUP_SIZE)), 65535)",
            "y": "ceilDiv(ceilDiv((numel(shapes.output)), (tunables.WORKGROUP_SIZE)), 65535)",
            "z": 1
          }
        }
      ]
    }
  ]
}
