            "block_table",
            { "scratch": "partialOut", "name": "partial_out", "elementType": "vec4<f32>" },
            { "scratch": "partialStats", "name": "partial_stats", "elementType": "vec2<f32>" },
            "params_main"
          ],
          "dispatch": { "x": "tokenCount", "y": "attrs.kv_num_heads", "z": "numSplits" }
