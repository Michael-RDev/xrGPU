            {
              "scratch": "partialStats",
              "name": "partial_stats",
              "buffer": "read-only-storage",
              "elementType": "vec2<f32>"
            },
            { "arg": "outputT", "name": "output", "elementType": "$outVec" }
          ],
          "dispatch": { "x": 1, "y": "attrs.num_heads", "z": "tokenCount" }
        }
      ]
    },
    {
      "id": "packed_slot",
      "when": ["pagedAttnStorageFits", "packedKv", "present.slotMappingT"],
      "requires": { "features": ["shader-f16"] },
      "passes": [
        {
          "id": "scatter",
          "name": "PagedAttention.ScatterKV",
          "shader": "paged-scatter-kv.wgsl.jinja",
          "bindings": ["query", "key_cache", "value_cache", "slot_mapping", "params_scatter"],
          "dispatch": {
            "x": "min(ceilDiv((tokenCount * attrs.kv_num_heads * headSize), (tunables.SCATTER_WORKGROUP_SIZE)), 65535)",
            "y": "ceilDiv(ceilDiv((tokenCount * attrs.kv_num_heads * headSize), (tunables.SCATTER_WORKGROUP_SIZE)), 65535)",
            "z": 1
          }
        },
        {
          "id": "main",
          "name": "PagedAttention.Attend",
          "shader": "paged-attention.wgsl.jinja",
          "bindings": [
            "query",
            "key_cache_main",
            "value_cache_main",
            "cumulative_sequence_length",
            "past_seqlens",
            "block_table",
            { "arg": "outputT", "name": "output", "elementType": "$aScalar" },
            "params_main"
          ],
          "dispatch": { "x": "tokenCount", "y": "attrs.kv_num_heads" }
        }
      ]
    }
  ]
}
