    {
      "name": "scatter-fold-wg1-independent-sequences",
      "provenance": {
        "notes": "A large scatter workload crosses the WebGPU dispatch-grid limit. One-token sequences bound attention cost; nonzero dyadic cycles expose missing tail writes and misplaced cache/value elements."
      },
      "attrs": { "num_heads": 8, "kv_num_heads": 8 },
      "tunables": { "WORKGROUP_SIZE": 64, "SCATTER_WORKGROUP_SIZE": 1 },
      "inputs": {
        "queryT": { "dtype": "float16", "shape": [64, 1024], "data": { "kind": "constant", "value": 0.0 } },
        "keyT": {
          "dtype": "float16",
          "shape": [64, 1024],
          "data": { "kind": "cycle", "values": [1.0, 2.0, 4.0, -1.0, -2.0] }
        },
        "valueT": {
          "dtype": "float16",
          "shape": [64, 1024],
          "data": { "kind": "cycle", "values": [2.0, -4.0, 8.0, 1.0, -2.0, 4.0, -1.0] }
        },
        "keyCacheT": { "dtype": "float16", "shape": [64, 1, 8, 128], "data": { "kind": "constant", "value": 0.0 } },
        "valueCacheT": { "dtype": "float16", "shape": [64, 1, 8, 128], "data": { "kind": "constant", "value": 0.0 } },
        "cumulativeSequenceLengthT": {
          "dtype": "int32",
          "shape": [65],
          "data": { "kind": "linspace", "start": 0, "end": 64 }
        },
        "pastSeqlensT": { "dtype": "int32", "shape": [64], "data": { "kind": "constant", "value": 0 } },
        "blockTableT": { "dtype": "int32", "shape": [64, 1], "data": { "kind": "linspace", "start": 0, "end": 63 } }
      },
      "outputs": {
        "outputT": { "dtype": "float16", "shape": [64, 1024] },
        "keyCacheT": { "dtype": "float16", "shape": [64, 1, 8, 128] },
        "valueCacheT": { "dtype": "float16", "shape": [64, 1, 8, 128] }
      },
      "preset": "edge",
      "vars": { "tokens": 64, "heads": 8, "headDim": 128 },
      "tunableSpace": { "WORKGROUP_SIZE": [64], "SCATTER_WORKGROUP_SIZE": [1] },
      "bench": {
        "metrics": [
          { "type": "bandwidth", "value": "6 * args.tokens * args.heads * args.headDim * 2", "provenance": "logical" }
        ]
      }
    },
