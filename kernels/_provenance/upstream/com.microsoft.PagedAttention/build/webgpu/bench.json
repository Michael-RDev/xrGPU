        "valueT": { "shape": [16, 4096], "dtype": "float16", "dist": "normal", "seed": 7602, "scale": 0.3 },
        "keyCacheT": { "shape": [2048, 16, 32, 128], "dtype": "float16", "dist": "normal", "seed": 7603, "scale": 0.3 },
        "valueCacheT": {
          "shape": [2048, 16, 32, 128],
          "dtype": "float16",
          "dist": "normal",
          "seed": 7604,
          "scale": 0.3
        },
        "cumulativeSequenceLengthT": {
          "shape": [17],
          "dtype": "int32",
          "data": { "kind": "linspace", "start": 0, "end": 16 }
        },
        "pastSeqlensT": { "shape": [16], "dtype": "int32", "dist": "constant", "value": 2047 },
        "blockTableT": {
          "shape": [16, 128],
          "dtype": "int32",
          "dist": "linearMod",
          "seed": 7606,
          "step": 1,
          "mod": 2048
        }
      },
      "outputs": { "outputT": { "shape": [16, 4096], "dtype": "float16" } },
      "bench": {
        "metrics": [{ "type": "bandwidth", "value": "2 * args.batch * args.kvHeads * args.past * args.headDim * 2" }]
      }
    },
    {
      "name": "paged-decode-mistral-b16-past4096-h32kv8-d128",
      "preset": "model",
      "provenance": {
        "notes": "Mistral class defaults (32 query heads, 8 key/value heads, head_dim 128) at 4096 tokens per sequence including the current token -- the GQA case, where the cache is a quarter the size for the same context. Context counts include this step: past_seqlens is context - 1 and the exclusive prefix [0, ..., batch] assigns one new token per sequence. All logical blocks map to distinct physical blocks, including the final append slot."
      },
      "vars": { "dtype": "float16", "batch": 16, "past": 4096, "heads": 32, "kvHeads": 8, "headDim": 128 },
