          "dispatch": { "x": "ceilDiv(attrs.N, tileCols)", "y": "rowGroups" }
        }
      ]
    },
    {
      "id": "staged_norm_nogb_noub",
      "priority": 10,
      "when": ["normContractOk", "biasPresence_nogb_noub", "normDispatchFits", "not hasSkip and not writeResidual"],
      "derive": { "inlineNorm": "0", "fromNormed": "1" },
      "intermediates": [{ "id": "normedA", "dtype": "float32", "shape": "[numel(shapes.aT)]" }],
      "passes": [
