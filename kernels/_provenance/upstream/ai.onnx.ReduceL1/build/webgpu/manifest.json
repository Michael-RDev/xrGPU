          "derive": { "indexing": "\"axis2d\"", "intMode": "dtypes.T == \"i32\"" },
          "bindings": ["x_t", "y", "params_axis0"],
          "dispatch": {
            "x": "min(ceilDiv((numel(shapes.y)), (reduceWorkgroupSize)), 65535)",
            "y": "ceilDiv(ceilDiv((numel(shapes.y)), (reduceWorkgroupSize)), 65535)",
            "z": 1
          }
        }
      ]
    },
    {
      "id": "axis1",
      "priority": 0,
      "when": ["not flatParallelCovered", "f16Ok(dtypes.T)", "ranks.x == 2", "reduceAxis == 1", "((attrs.keepdims == 0 and ranks.y == 1 and dim(shapes.y, 0) == dim(shapes.x, 0)) or (attrs.keepdims == 1 and ranks.y == 2 and dim(shapes.y, 0) == dim(shapes.x, 0) and dim(shapes.y, 1) == 1))"],
      "derive": { "axis": 1, "scalar": "dtypes.T" },
      "passes": [
        {
          "id": "main",
          "name": "ReduceL1.Axis1",
          "shader": "reduce-serial-axis.wgsl.jinja",
          "derive": { "indexing": "\"axis2d\"", "intMode": "dtypes.T == \"i32\"" },
          "bindings": ["x_t", "y", "params_axis1"],
          "dispatch": {
            "x": "min(ceilDiv((numel(shapes.y)), (reduceWorkgroupSize)), 65535)",
            "y": "ceilDiv(ceilDiv((numel(shapes.y)), (reduceWorkgroupSize)), 65535)",
            "z": 1
          }
        }
      ]
    },
    {
      "id": "strided_axis_serial",
      "priority": 16,
      "when": ["not flatParallelCovered", "(dtypes.T == \"f32\" or dtypes.T == \"f16\") and f16Ok(dtypes.T)", "ranks.x >= 3", "reduceAxis < ranks.x - 1", "axisSplitDim > 0 and axisSplitInner > 0", "numel(shapes.y) > 0", "numel(shapes.y) == rows(shapes.x, reduceAxis)", "((attrs.keepdims == 0 and ranks.y == ranks.x - 1) or (attrs.keepdims == 1 and ranks.y == ranks.x and dim(shapes.y, reduceAxis) == 1))"],
      "supersededBy": ["axis_split_tiled_narrow", "axis_split"],
      "derive": { "workgroupSize": "reduceWorkgroupSize", "scalar": "dtypes.T" },
      "passes": [
        {
          "id": "main",
