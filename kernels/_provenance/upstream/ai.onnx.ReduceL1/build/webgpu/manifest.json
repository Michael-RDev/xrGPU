            "innerSize": "axisSplitInner",
            "usesF16": "dtypes.T == \"f16\"",
            "tailPaddingElements": "numel(shapes.y) % 2 if dtypes.T == \"f16\" else 0"
          },
          "bindings": [{ "arg": "x", "elementType": "$scalar" }, { "arg": "y", "elementType": "$scalar" }],
          "dispatch": {
            "x": "min(ceilDiv((numel(shapes.y)), (reduceWorkgroupSize)), 65535)",
            "y": "ceilDiv(ceilDiv((numel(shapes.y)), (reduceWorkgroupSize)), 65535)",
            "z": 1
          }
        }
      ]
    }
  ]
